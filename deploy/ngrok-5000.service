# Install on the tbot Pi (192.168.1.216):
#   sudo cp ngrok-5000.service /etc/systemd/system/ngrok-5000.service
#   sudo cp ngrok-5000-traffic-policy.yml.example /etc/ngrok-5000-traffic-policy.yml   # then fill in real creds
#   sudo chown tbot:tbot /etc/ngrok-5000-traffic-policy.yml
#   sudo chmod 0600 /etc/ngrok-5000-traffic-policy.yml
#   sudo systemctl daemon-reload
#   sudo systemctl enable ngrok-5000.service   # optional: start on boot
#
# Requires ngrok already installed and authenticated as the tbot user:
#   ngrok config add-authtoken <token>   # run once as tbot, writes ~/.config/ngrok/ngrok.yml
#
# The tunnel is protected by HTTP Basic Auth via ngrok's traffic-policy file
# (--basic-auth is deprecated and, worse, would leak the password in plaintext
# to any local user via `ps`/`systemctl status`). The policy file is read by
# the ngrok process itself (running as tbot), so it's owned tbot:tbot 0600 --
# readable only by tbot, not world-readable like the rest of /etc.

[Unit]
Description=ngrok tunnel for port 5000
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=tbot
ExecStart=/usr/local/bin/ngrok http 5000 --log=stdout --traffic-policy-file=/etc/ngrok-5000-traffic-policy.yml
Restart=on-failure
RestartSec=5
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
