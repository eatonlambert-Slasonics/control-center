# Copy to /etc/ngrok-5000-traffic-policy.yml on the tbot Pi, fill in a real
# password, then:
#   sudo chown tbot:tbot /etc/ngrok-5000-traffic-policy.yml
#   sudo chmod 0600 /etc/ngrok-5000-traffic-policy.yml

on_http_request:
  - actions:
      - type: basic-auth
        config:
          realm: "tbot-pi"
          credentials:
            - "changeme:changeme"
