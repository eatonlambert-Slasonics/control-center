[Unit]
Description=Admin Console Dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/tone/projects/control-center
Environment=ADMIN_CONSOLE_CONFIG=/home/tone/projects/control-center/config.yaml
ExecStart=/home/tone/projects/control-center/venv/bin/python /home/tone/projects/control-center/app.py
Restart=on-failure
RestartSec=5

# Keep the dashboard itself unprivileged -- it never needs root.
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
